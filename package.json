{
  "name": "topojs",
  "version": "1.0.0",
  "private": false,
  "description": "Pure-JavaScript persistent homology library (H0, H1, H2, cubical). No WASM, WebGL, WebGPU, or server required.",
  "type": "module",
  "license": "MIT",
  "author": "TopoJS Contributors",
  "keywords": [
    "persistent homology",
    "TDA",
    "topological data analysis",
    "Vietoris-Rips",
    "cubical complex",
    "computational topology",
    "javascript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/topojs.git"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "demo:real-data": "node --experimental-transform-types bench/real-data-validation.ts",
    "bench:incremental:real-data": "node --experimental-transform-types bench/incremental-real-data-benchmark.ts",
    "bench:incremental:iris": "node --experimental-transform-types bench/incremental-iris-benchmark.ts",
    "bench:incremental:melbourne-temp": "node --experimental-transform-types bench/incremental-melbourne-temp-benchmark.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "CITATION.cff"
  ]
}
