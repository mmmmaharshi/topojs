{
  "name": "topojs",
  "version": "1.0.0",
  "private": false,
  "description": "Pure-JavaScript persistent homology library (H0, H1, H2, cubical). No WASM, WebGL, WebGPU, or server required.",
  "keywords": [
    "TDA",
    "Vietoris-Rips",
    "computational topology",
    "cubical complex",
    "javascript",
    "persistent homology",
    "topological data analysis"
  ],
  "license": "MIT",
  "author": "TopoJS Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/mmmmaharshi/topojs.git"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "CITATION.cff"
  ],
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "build:demo": "esbuild demo/bundle-entry.ts --bundle --format=esm --minify --outfile=demo/topojs-bundle.mjs",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "demo:real-data": "node --experimental-strip-types bench/real-data-validation.ts",
    "bench": "node --experimental-strip-types --expose-gc bench/benchmark.ts",
    "bench:all": "npm run bench && for d in sunspots iris melbourne-temp; do npm run bench -- --scaling $d && npm run bench -- --memory $d; done && npm run bench -- --regime"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^6.0.3",
    "ultracite": "^7.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.7"
  }
}
